# Node.js 24 LTS (uses built-in node:sqlite)
# Optional HTTP proxy override. The server reads the Windows system proxy automatically on Node 24.14+.
# HTTPS_PROXY=http://127.0.0.1:7890
API_PORT=3001
WEB_PORT=5173
DATABASE_PATH=./data/anime-note.sqlite
# Replace YOUR_BANGUMI_USERNAME with your own developer/user ID.
BANGUMI_USER_AGENT=YOUR_BANGUMI_USERNAME/paper-screen/0.1.0
# Optional: never expose this token to the browser or commit .env.
BANGUMI_TOKEN=

# Optional: existing directory on a separate drive or NAS. Use an absolute path.
# PERSONAL_BACKUP_DIR="E:/AnimeNoteBackups"
