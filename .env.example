# Node.js 24 LTS (uses built-in node:sqlite)
API_PORT=3001
WEB_PORT=5173
DATABASE_PATH=./data/anime-note.sqlite
# Replace YOUR_BANGUMI_USERNAME with your own developer/user ID.
BANGUMI_USER_AGENT=YOUR_BANGUMI_USERNAME/paper-screen/0.1.0
# Optional: never expose this token to the browser or commit .env.
BANGUMI_TOKEN=
